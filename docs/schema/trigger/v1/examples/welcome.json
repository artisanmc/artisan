{
  "schema": "trigger/v1",
  "on": "player_join",
  "notes": "Replaces the vanilla join message, translated: each player reads it in their own language.",
  "do": [
    {
      "if": [
        {
          "has_permission": "rank.vip"
        }
      ],
      "do": [
        {
          "set_event": {
            "join_message": {
              "fr": "<gold>{player} rejoint le royaume",
              "en": "<gold>{player} joins the kingdom"
            }
          }
        }
      ],
      "else": [
        {
          "set_event": {
            "join_message": {
              "fr": "<gray>{player} est de retour, absent depuis {player.last_seen.ago()}",
              "en": "<gray>{player} is back after {player.last_seen.ago()}"
            }
          }
        }
      ]
    }
  ]
}
