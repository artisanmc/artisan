{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.artisanmc.net/schema/model/v1.json",
  "title": "Artisan Data model",
  "description": "Shape nommée de données (schéma de champs récursif déclaré par l'admin) à laquelle le contenu des Project sources se conforme. Store lossless côté éditeur : les data/<id>.yaml restent dénormalisés et self-contained pour le runtime — le plugin ignore models/ entièrement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "key_field",
    "fields"
  ],
  "properties": {
    "schema": {
      "const": "model/v1"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "key_field": {
      "type": "string",
      "description": "Champ scalaire top-level servant de Row key."
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Field"
      }
    },
    "version": {
      "type": "integer",
      "description": "Version monotone d'un model DÉCLARÉ par un Add-on (ADR composable-data-models §4/§5). Absent pour un model project-authored."
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "steps"],
        "properties": {
          "from": { "type": "integer" },
          "to": { "type": "integer" },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "Pas déclaratif (vocabulaire fermé — jamais de code) : rename_field {from,to,path?}, set_default {field,value,path?}, rename_enum_value {field,from,to,path?}, rename_variant {field,tag?,from,to,path?}. Op inconnue = ignorée (dangle)."
            }
          }
        }
      },
      "description": "Chaîne de migrations déclaratives embarquée dans la déclaration, appliquée côté éditeur (ADR composable-data-models §5)."
    }
  },
  "$defs": {
    "Field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/FieldType"
        }
      }
    },
    "FieldType": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "string",
                "number",
                "integer",
                "boolean",
                "ltext",
                "minimessage",
                "minimessage_multiline",
                "item",
                "actions"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "of"
          ],
          "properties": {
            "kind": {
              "const": "list"
            },
            "of": {
              "$ref": "#/$defs/FieldType"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "fields"
          ],
          "properties": {
            "kind": {
              "const": "object"
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Field"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ref"
          ],
          "properties": {
            "kind": {
              "const": "model"
            },
            "ref": {
              "type": "string",
              "description": "Id d'un autre Data model (models/<ref>.yaml). Pas de cycles."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "of"
          ],
          "properties": {
            "kind": {
              "const": "map"
            },
            "of": {
              "$ref": "#/$defs/FieldType",
              "description": "Dictionnaire clé string → valeur de ce type (ADR composable-data-models)."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "values"
          ],
          "properties": {
            "kind": {
              "const": "enum"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Ensemble fermé ; la valeur stockée est une string. Fermeture vérifiée à l'édition seulement (contrat non-hermétique)."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "tag",
            "variants"
          ],
          "properties": {
            "kind": {
              "const": "union"
            },
            "tag": {
              "type": "string",
              "description": "Nom du champ discriminant porté par la valeur."
            },
            "variants": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "fields"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "fields": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Field"
                    }
                  }
                }
              },
              "description": "Variantes de DONNÉES uniquement — les comportements passent par les kinds core actions/conditions (ADR composable-data-models)."
            }
          }
        }
      ]
    }
  }
}
