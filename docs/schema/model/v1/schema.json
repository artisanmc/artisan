{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.artisanmc.net/schema/model/v1.json",
  "title": "Artisan Data model",
  "description": "A named data shape (recursive fields) that Project sources follow. Editor only: data/<id>.yaml files stay self-contained and the server ignores models/.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "key_field",
    "fields"
  ],
  "properties": {
    "schema": {
      "const": "model/v1"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "key_field": {
      "type": "string",
      "description": "The top-level scalar field used as row key."
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Field"
      }
    },
    "version": {
      "type": "integer",
      "description": "Increasing version of a model declared by an add-on. Absent for a model written in the Project."
    },
    "master_detail": {
      "type": "boolean",
      "description": "Display hint: the editor shows this model's table as a list plus a form for the selected row, instead of a grid."
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "steps"],
        "properties": {
          "from": { "type": "integer" },
          "to": { "type": "integer" },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "A declarative step (closed list, never code): rename_field {from,to,path?}, set_default {field,value,path?}, rename_enum_value {field,from,to,path?}, rename_variant {field,tag?,from,to,path?}. Unknown ops are ignored."
            }
          }
        }
      },
      "description": "Declarative migrations, applied by the editor."
    }
  },
  "$defs": {
    "Field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/FieldType"
        },
        "label": { "type": "string", "description": "Display hint: label in the generated form (default: the field name)." },
        "help": { "type": "string", "description": "Display hint: help text (tooltip)." },
        "section": { "type": "string", "description": "Display hint: the section heading the field is grouped under." },
        "required": { "type": "boolean", "description": "Validation: blocking in the form, only reported for hand edits." },
        "default": { "description": "Value for new rows, and the value of a set_default migration step." },
        "min": { "type": "number", "description": "Minimum (number and integer)." },
        "max": { "type": "number", "description": "Maximum (number and integer)." },
        "pattern": { "type": "string", "description": "Regex the string value must match." },
        "locked": { "type": "boolean", "description": "The add-on manages this value: read-only in the form (a hand edit is still possible, and reported)." }
      }
    },
    "FieldType": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "string",
                "number",
                "integer",
                "boolean",
                "ltext",
                "minimessage",
                "minimessage_multiline",
                "item",
                "actions", "conditions"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "of"
          ],
          "properties": {
            "kind": {
              "const": "list"
            },
            "of": {
              "$ref": "#/$defs/FieldType"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "fields"
          ],
          "properties": {
            "kind": {
              "const": "object"
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Field"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ref"
          ],
          "properties": {
            "kind": {
              "const": "model"
            },
            "ref": {
              "type": "string",
              "description": "Id of another Data model (models/<ref>.yaml). No cycles."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "of"
          ],
          "properties": {
            "kind": {
              "const": "map"
            },
            "of": {
              "$ref": "#/$defs/FieldType",
              "description": "A map of string keys to values of this type."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "values"
          ],
          "properties": {
            "kind": {
              "const": "enum"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "A closed set; the stored value is a string. Checked in the editor only."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "tag",
            "variants"
          ],
          "properties": {
            "kind": {
              "const": "union"
            },
            "tag": {
              "type": "string",
              "description": "Name of the field that picks the variant."
            },
            "variants": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "fields"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "fields": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Field"
                    }
                  }
                }
              },
              "description": "Data variants only; behaviour goes through actions and conditions."
            }
          }
        }
      ]
    }
  }
}
