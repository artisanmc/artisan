{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.artisanmc.net/schema/dialog/v1.json",
  "title": "Artisan Dialog",
  "description": "Format intermédiaire d'un dialog Artisan (Paper 1.21+ dialogs). Source de vérité du wire émis par l'éditeur (transform.ts serializeDialog) et lu par le plugin (DialogYaml).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "title",
    "buttons"
  ],
  "properties": {
    "schema": {
      "const": "dialog/v1",
      "description": "Version du schéma. Verrouillée pour permettre les migrations applicables au load."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "description": "LEGACY, ignoré. L'identité d'un Document est le nom de son fichier (le reader force la valeur et signale une divergence). Toléré en lecture pour les projects antérieurs ; plus jamais écrit."
    },
    "title": {
      "$ref": "#/$defs/LText",
      "description": "Titre affiché. Référence i18n {i18n:key}, littéral MiniMessage, ou map field-local."
    },
    "can_close_with_escape": {
      "type": "boolean",
      "default": true,
      "description": "Émis uniquement quand false (le joueur ne peut pas fermer avec Échap)."
    },
    "body": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DialogBody"
      },
      "description": "Blocs de contenu affichés au-dessus des inputs/boutons."
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DialogInput"
      },
      "description": "Champs de saisie. Les valeurs sont exposées comme args de contexte aux actions des boutons."
    },
    "buttons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DialogButton"
      },
      "description": "Boutons du dialog, dans l'ordre d'affichage."
    }
  },
  "$defs": {
    "LText": {
      "description": "Un texte de slot structurel (ADR field-local-translations) : string ('{i18n:key}' ou littéral, identique pour toutes les langues) ou map field-local { LangCode: texte }.",
      "oneOf": [
        {
          "type": "string",
          "description": "Référence i18n {i18n:key} ou littéral MiniMessage."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z]{2,3}(_[A-Za-z]{2,4})?$": {
              "type": "string"
            }
          },
          "description": "Map field-local { lang: texte }."
        }
      ]
    },
    "DialogBody": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "$ref": "#/$defs/LText",
              "description": "Référence i18n {i18n:key}, littéral MiniMessage, ou map field-local."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "material"
          ],
          "properties": {
            "type": {
              "const": "item"
            },
            "material": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64,
              "default": 1
            }
          }
        }
      ]
    },
    "DialogInput": {
      "type": "object",
      "required": [
        "id",
        "type",
        "label"
      ],
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/InputId"
            },
            "type": {
              "const": "text"
            },
            "label": {
              "$ref": "#/$defs/LText"
            },
            "default": {
              "type": "string"
            },
            "max_length": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/InputId"
            },
            "type": {
              "const": "bool"
            },
            "label": {
              "$ref": "#/$defs/LText"
            },
            "default": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          }
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/InputId"
            },
            "type": {
              "const": "number_range"
            },
            "label": {
              "$ref": "#/$defs/LText"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "default": {
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/InputId"
            },
            "type": {
              "const": "single_option"
            },
            "label": {
              "$ref": "#/$defs/LText"
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "label"
                ],
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "label": {
                    "$ref": "#/$defs/LText"
                  }
                }
              }
            },
            "default": {
              "type": "string"
            }
          }
        }
      ]
    },
    "DialogButton": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/InputId"
        },
        "label": {
          "$ref": "#/$defs/LText"
        },
        "actions": {
          "description": "Chaîne d'actions exécutée au clic du bouton. Wire canonique : steps structurés (ou un step / une liste). Une string = ancien Action DSL (legacy). Cf. ADR structured-action-wire.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            },
            {
              "type": "array"
            }
          ]
        }
      }
    },
    "InputId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    }
  }
}
