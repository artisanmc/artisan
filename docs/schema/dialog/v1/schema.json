{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.artisanmc.net/schema/dialog/v1.json",
  "title": "Artisan Dialog",
  "description": "Format intermédiaire d'un dialog Artisan (Paper 1.21+ dialogs). Source de vérité du wire émis par l'éditeur (transform.ts serializeDialog) et lu par le plugin (DialogYaml).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "title",
    "buttons"
  ],
  "properties": {
    "schema": {
      "const": "dialog/v1",
      "description": "Version du schéma. Verrouillée pour permettre les migrations applicables au load."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "description": "LEGACY, ignoré. L'identité d'un Document est le nom de son fichier (le reader force la valeur et signale une divergence). Toléré en lecture pour les projects antérieurs ; plus jamais écrit."
    },
    "title": {
      "type": "string",
      "description": "Titre affiché. Référence i18n {i18n:key} ou littéral MiniMessage."
    },
    "can_close_with_escape": {
      "type": "boolean",
      "default": true,
      "description": "Émis uniquement quand false (le joueur ne peut pas fermer avec Échap)."
    },
    "body": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DialogBody"
      },
      "description": "Blocs de contenu affichés au-dessus des inputs/boutons."
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DialogInput"
      },
      "description": "Champs de saisie. Les valeurs sont exposées comme args de contexte aux actions des boutons."
    },
    "buttons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DialogButton"
      },
      "description": "Boutons du dialog, dans l'ordre d'affichage."
    }
  },
  "$defs": {
    "DialogBody": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "description": "Référence i18n {i18n:key} ou littéral MiniMessage."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "material"
          ],
          "properties": {
            "type": {
              "const": "item"
            },
            "material": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64,
              "default": 1
            }
          }
        }
      ]
    },
    "DialogInput": {
      "type": "object",
      "required": [
        "id",
        "type",
        "label"
      ],
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/InputId"
            },
            "type": {
              "const": "text"
            },
            "label": {
              "type": "string"
            },
            "default": {
              "type": "string"
            },
            "max_length": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/InputId"
            },
            "type": {
              "const": "bool"
            },
            "label": {
              "type": "string"
            },
            "default": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          }
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/InputId"
            },
            "type": {
              "const": "number_range"
            },
            "label": {
              "type": "string"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "default": {
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/InputId"
            },
            "type": {
              "const": "single_option"
            },
            "label": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "label"
                ],
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  }
                }
              }
            },
            "default": {
              "type": "string"
            }
          }
        }
      ]
    },
    "DialogButton": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/InputId"
        },
        "label": {
          "type": "string"
        },
        "actions": {
          "type": "string",
          "description": "Chaîne Action DSL exécutée au clic du bouton (actions + branches if/else, comme les click-handlers de menu). Cf. ADR action-dsl — remplace l'ancienne liste d'actions plates ; les branches if round-trip désormais."
        }
      }
    },
    "InputId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    }
  }
}
