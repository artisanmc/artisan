{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.artisanmc.net/schema/dialog/v1.json",
  "title": "Artisan Dialog",
  "description": "An Artisan dialog (Paper 1.21+ dialogs).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "title",
    "buttons"
  ],
  "properties": {
    "schema": {
      "const": "dialog/v1",
      "description": "Schema version. Fixed, so that migrations can apply on load."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "description": "LEGACY, ignored. A Document's identity is its file name (the reader overrides this value and reports a mismatch). Still read in older Projects; never written."
    },
    "title": {
      "$ref": "#/$defs/LText",
      "description": "Displayed title: an {i18n:key} reference, MiniMessage text, or a {language: text} map."
    },
    "can_close_with_escape": {
      "type": "boolean",
      "default": true,
      "description": "Written only when false (the player cannot close it with Escape)."
    },
    "body": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DialogBody"
      },
      "description": "Content blocks shown above the inputs and buttons."
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DialogInput"
      },
      "description": "Input fields. Their values reach the buttons' actions as context arguments."
    },
    "buttons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DialogButton"
      },
      "description": "The dialog's buttons, in display order."
    }
  },
  "$defs": {
    "LText": {
      "description": "A text: a string ('{i18n:key}' or literal, the same in every language) or a { language: text } map.",
      "oneOf": [
        {
          "type": "string",
          "description": "An {i18n:key} reference or MiniMessage text."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z]{2,3}(_[A-Za-z]{2,4})?$": {
              "type": "string"
            }
          },
          "description": "A { language: text } map."
        }
      ]
    },
    "DialogBody": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "$ref": "#/$defs/LText",
              "description": "An {i18n:key} reference, MiniMessage text, or a { language: text } map."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "material"
          ],
          "properties": {
            "type": {
              "const": "item"
            },
            "material": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64,
              "default": 1
            }
          }
        }
      ]
    },
    "DialogInput": {
      "type": "object",
      "required": [
        "id",
        "type",
        "label"
      ],
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/InputId"
            },
            "type": {
              "const": "text"
            },
            "label": {
              "$ref": "#/$defs/LText"
            },
            "default": {
              "type": "string"
            },
            "max_length": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/InputId"
            },
            "type": {
              "const": "bool"
            },
            "label": {
              "$ref": "#/$defs/LText"
            },
            "default": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          }
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/InputId"
            },
            "type": {
              "const": "number_range"
            },
            "label": {
              "$ref": "#/$defs/LText"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "default": {
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/InputId"
            },
            "type": {
              "const": "single_option"
            },
            "label": {
              "$ref": "#/$defs/LText"
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "label"
                ],
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "label": {
                    "$ref": "#/$defs/LText"
                  }
                }
              }
            },
            "default": {
              "type": "string"
            }
          }
        }
      ]
    },
    "DialogButton": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/InputId"
        },
        "label": {
          "$ref": "#/$defs/LText"
        },
        "actions": {
          "description": "The action chain run when the button is clicked: a list of steps (or a single step). A plain string is the legacy Action DSL.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            },
            {
              "type": "array"
            }
          ]
        }
      }
    },
    "InputId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    }
  }
}
