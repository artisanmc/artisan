{
  "schema": "menu/v1",
  "id": "shop_main",
  "title": "§6Shop principal",
  "size": 27,
  "permission": "menu.shop.open",
  "background": { "asset": "shop_bg.png" },
  "open_actions": [
    { "type": "play_sound", "sound": "block.chest.open", "volume": 0.5, "pitch": 1 }
  ],
  "layers": [
    {
      "id": "items",
      "name": "Items",
      "elements": [
        {
          "id": "btn_diamond_sword",
          "positions": "11",
          "appearances": [
            {
              "material": "DIAMOND_SWORD",
              "title": "§bÉpée diamant",
              "lore": ["§7Prix: §a200$", "", "§eClique pour acheter"],
              "click": {
                "left": {
                  "requirements": [{ "type": "has_money", "amount": 200 }],
                  "actions": [
                    { "type": "take_money", "amount": 200 },
                    { "type": "give_item", "material": "DIAMOND_SWORD", "count": 1 },
                    { "type": "send_message", "text": "§aÉpée achetée !" },
                    { "type": "play_sound", "sound": "entity.experience_orb.pickup", "volume": 1, "pitch": 1 }
                  ],
                  "fallback": [{ "type": "send_message", "text": "§cTu n'as pas assez d'argent." }],
                  "cooldown": {
                    "id": "shop_diamond_sword",
                    "duration_seconds": 5,
                    "scope": "player",
                    "message": "§7Attends %time_left%s avant de racheter."
                  }
                }
              }
            }
          ],
          "tags": ["shop", "weapons"]
        },
        {
          "id": "btn_rank_vip",
          "positions": "15",
          "appearances": [
            {
              "if": [{ "type": "has_permission", "perm": "rank.vip" }],
              "asset": "rank_vip_owned.png",
              "title": "§6Rank VIP",
              "lore": ["§aDéjà possédé"],
              "click": null
            },
            {
              "if": [{ "type": "not", "of": { "type": "has_money", "amount": 500 } }],
              "asset": "rank_vip_disabled.png",
              "title": "§6Rank VIP",
              "lore": ["§cIl te manque de l'argent"],
              "click": null
            },
            {
              "asset": "rank_vip_button.png",
              "title": "§6Rank VIP",
              "lore": ["§7Prix: §a500$", "", "§eClique pour acheter"],
              "click": {
                "left": {
                  "requirements": [{ "type": "has_money", "amount": 500 }],
                  "actions": [
                    { "type": "take_money", "amount": 500 },
                    { "type": "run_command", "command": "lp user %player_name% parent set vip", "as": "console" },
                    { "type": "send_message", "text": "§aRank VIP débloqué !" },
                    { "type": "broadcast", "text": "§e%player_name% §7vient de débloquer le rank §6VIP §7!" }
                  ],
                  "fallback": [{ "type": "send_message", "text": "§cPas assez d'argent." }]
                }
              }
            }
          ],
          "tags": ["shop", "ranks"]
        },
        {
          "id": "btn_close",
          "positions": "22",
          "appearances": [
            {
              "material": "BARRIER",
              "title": "§cFermer",
              "click": { "left": { "actions": [{ "type": "close_menu" }] } }
            }
          ]
        }
      ]
    }
  ]
}
