{
  "schema": "menu/v1",
  "id": "shop_with_decoration",
  "title": "§6Shop élégant",
  "size": 27,
  "permission": "menu.shop.open",
  "layers": [
    {
      "id": "decoration",
      "name": "Décoration",
      "elements": [
        {
          "id": "deco_top_row",
          "positions": "0-8",
          "material": "GRAY_STAINED_GLASS_PANE",
          "title": " "
        },
        {
          "id": "deco_bottom_row",
          "positions": "18-26",
          "material": "GRAY_STAINED_GLASS_PANE",
          "title": " "
        }
      ]
    },
    {
      "id": "items",
      "name": "Items",
      "elements": [
        {
          "id": "btn_buy_vip",
          "positions": "4",
          "tags": [
            "shop",
            "ranks"
          ],
          "states": [
            {
              "if": [
                {
                  "type": "not",
                  "of": {
                    "type": "has_permission",
                    "perm": "rank.vip"
                  }
                }
              ],
              "asset": "vip_button.png",
              "title": "§6Acheter VIP",
              "lore": [
                "§7Prix: §a500$",
                "",
                "§eClique pour acheter"
              ],
              "click": {
                "left": {
                  "steps": "if has_money(500):\n  take_money 500\n  run_command \"lp user %player_name% parent set vip\" as console\n  send_message \"§aRank VIP débloqué !\"\nelse:\n  send_message \"§cPas assez d'argent.\""
                }
              }
            }
          ]
        },
        {
          "id": "btn_diamond_sword",
          "positions": "13",
          "material": "DIAMOND_SWORD",
          "title": "§bÉpée diamant",
          "lore": [
            "§7Prix: §a200$"
          ],
          "click": {
            "left": {
              "steps": "if has_money(200):\n  take_money 200\n  give_item DIAMOND_SWORD 1\nelse:\n  send_message \"§cPas assez d'argent.\""
            }
          }
        },
        {
          "id": "btn_close",
          "positions": "22",
          "material": "BARRIER",
          "title": "§cFermer",
          "click": {
            "left": {
              "steps": "close_menu"
            }
          }
        }
      ]
    }
  ]
