{
  "schema": "menu/v1",
  "id": "profile_overview",
  "title": "§6Mon profil",
  "size": 54,
  "background": {
    "asset": "profile_bg.png"
  },
  "layers": [
    {
      "id": "default",
      "name": "Default",
      "elements": [
        {
          "id": "header_quests",
          "positions": "1",
          "asset": "header_quests.png",
          "title": "§6Quêtes en cours"
        },
        {
          "id": "quests_list",
          "positions": "9-17",
          "component_ref": "questx:quest_button",
          "asset": "quest_btn.png",
          "lore": [
            "§7{{questx:quest_name}}",
            "§7Avancement : §e{{questx:quest_progress}}"
          ],
          "click": null
        },
        {
          "id": "quests_prev",
          "positions": "0",
          "asset": "arrow_left.png",
          "title": "§7Quêtes : page précédente",
          "click": {
            "left": {
              "steps": "paginate prev quests_list"
            }
          },
          "states": [
            {
              "if": [
                {
                  "type": "pagination_at_first",
                  "element_id": "quests_list"
                }
              ],
              "asset": "arrow_left_disabled.png",
              "click": null
            }
          ]
        },
        {
          "id": "quests_next",
          "positions": "18",
          "asset": "arrow_right.png",
          "title": "§7Quêtes : page suivante",
          "click": {
            "left": {
              "steps": "paginate next quests_list"
            }
          },
          "states": [
            {
              "if": [
                {
                  "type": "pagination_at_last",
                  "element_id": "quests_list"
                }
              ],
              "asset": "arrow_right_disabled.png",
              "click": null
            }
          ]
        },
        {
          "id": "header_achievements",
          "positions": "28",
          "asset": "header_achievements.png",
          "title": "§6Succès débloqués"
        },
        {
          "id": "achievements_list",
          "positions": "36-44",
          "component_ref": "achievementsplus:achievement_icon",
          "asset": "achievement_btn.png",
          "lore": [
            "§7{{achievementsplus:name}}",
            "§7Débloqué le §e{{achievementsplus:unlocked_at}}"
          ],
          "click": null
        },
        {
          "id": "achievements_prev",
          "positions": "27",
          "asset": "arrow_left.png",
          "title": "§7Succès : page précédente",
          "click": {
            "left": {
              "steps": "paginate prev achievements_list"
            }
          },
          "states": [
            {
              "if": [
                {
                  "type": "pagination_at_first",
                  "element_id": "achievements_list"
                }
              ],
              "asset": "arrow_left_disabled.png",
              "click": null
            }
          ]
        },
        {
          "id": "achievements_next",
          "positions": "45",
          "asset": "arrow_right.png",
          "title": "§7Succès : page suivante",
          "click": {
            "left": {
              "steps": "paginate next achievements_list"
            }
          },
          "states": [
            {
              "if": [
                {
                  "type": "pagination_at_last",
                  "element_id": "achievements_list"
                }
              ],
              "asset": "arrow_right_disabled.png",
              "click": null
            }
          ]
        },
        {
          "id": "btn_close",
          "positions": "53",
          "material": "BARRIER",
          "title": "§cFermer",
          "click": {
            "left": {
              "steps": "close_menu"
            }
          }
        }
      ]
    }
  ],
  "metadata": {
    "uses_plugins": [
      "questx",
      "achievementsplus"
    ]
  }
}
