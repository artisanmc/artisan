{
  "schema": "menu/v1",
  "id": "chestshop_grid",
  "title": "{i18n:menu.shop.title}",
  "size": 54,
  "permission": "shop.view",
  "contextInputs": [
    {
      "name": "category",
      "type": "string"
    },
    {
      "name": "shops",
      "type": "list",
      "source": {
        "ref": "chestshop:items",
        "filter": {
          "category": "{category}"
        },
        "sort": {
          "by": "price",
          "direction": "asc"
        },
        "limit": 28
      }
    }
  ],
  "layers": [
    {
      "id": "decoration",
      "name": "Décoration",
      "elements": [
        {
          "id": "deco_top",
          "positions": "0-8",
          "material": "BLACK_STAINED_GLASS_PANE",
          "title": " "
        },
        {
          "id": "deco_bottom",
          "positions": "45-53",
          "material": "BLACK_STAINED_GLASS_PANE",
          "title": " "
        }
      ]
    },
    {
      "id": "items",
      "name": "Items shop",
      "elements": [
        {
          "id": "shop_grid",
          "positions": "10-43",
          "material": "{shop.material}",
          "title": "<white>{shop.name}</white>",
          "lore": [
            "<gray>{shop.description}</gray>",
            "",
            "<yellow>Prix : {shop.price} pièces</yellow>"
          ],
          "click": {
            "left": {
              "steps": "run_command \"cs buy {shop.id}\" as player"
            }
          },
          "iterates": {
            "source": "shops",
            "alias": "shop"
          },
          "states": [
            {
              "if": [
                {
                  "type": "placeholder_equals",
                  "placeholder": "{shop.rarity}",
                  "value": "legendary"
                }
              ],
              "material": "{shop.material}",
              "title": "<gold><bold>{shop.name}</bold></gold>",
              "lore": [
                "<gray>{shop.description}</gray>",
                "",
                "<yellow>Prix : {shop.price} pièces</yellow>",
                "<dark_gray>Click gauche pour acheter</dark_gray>"
              ],
              "enchanted": true,
              "click": {
                "left": {
                  "steps": "run_command \"cs buy {shop.id}\" as player\nplay_sound entity.experience_orb.pickup"
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "uses_plugins": [
      "chestshop"
    ]
  }
}
