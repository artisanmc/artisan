{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.artisanmc.net/schema/menu/v1.json",
  "title": "Artisan Menu",
  "description": "Format intermédiaire d'un menu Artisan. Source de vérité unique pour un menu.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "size", "layers"],
  "properties": {
    "schema": {
      "const": "menu/v1",
      "description": "Version du schéma. Verrouillée pour permettre les migrations applicables au load."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "description": "Identifiant stable du menu, utilisé en /menu open <id>. Lowercase + underscore."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Titre affiché en haut de l'inventaire. Format MiniMessage. Supporte placeholders et {i18n:key}."
    },
    "size": {
      "type": "integer",
      "enum": [9, 18, 27, 36, 45, 54],
      "description": "Taille de l'inventaire en nombre de positions Minecraft (multiple de 9, max 54 = double chest)."
    },
    "permission": {
      "type": "string",
      "description": "Permission requise pour ouvrir le menu. Si absente, ouvert à tous."
    },
    "notes": {
      "type": "string",
      "maxLength": 2048,
      "description": "Notes internes de l'admin (jamais rendues aux joueurs). Survivent au round-trip JSON ↔ YAML, contrairement aux commentaires YAML qui sont perdus à la conversion."
    },
    "background": {
      "$ref": "#/$defs/Appearance",
      "description": "Apparence par défaut des positions Minecraft non couvertes par un Element visible."
    },
    "contextInputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/ContextInput" },
      "description": "Slots nommées exposées par le menu. Peuplées à l'ouverture par auto-binding par nom (cf. §15.4) ou par un ConnectorBinding (cf. §14). Référencées via {name} dans tout champ texte."
    },
    "open_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/Condition" },
      "description": "Conditions à valider à l'ouverture. Si une échoue, le menu ne s'ouvre pas."
    },
    "open_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/Action" },
      "description": "Actions exécutées à l'ouverture du menu."
    },
    "close_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/Action" },
      "description": "Actions exécutées à la fermeture du menu."
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Layer" },
      "description": "Liste des layers du menu, ordonnés bottom → top."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Métadonnées calculées par l'éditeur. Non éditables manuellement.",
      "properties": {
        "uses_plugins": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Liste des plugins tiers référencés via component_ref ou ContextInput.source. Calculée automatiquement."
        },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "author": { "type": "string" }
      }
    }
  },
  "$defs": {
    "Layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "elements"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "description": "Identifiant slug du layer, unique dans le menu."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Nom affiché dans le panel layer de l'éditeur."
        },
        "notes": {
          "type": "string",
          "maxLength": 1024,
          "description": "Notes internes de l'admin (jamais rendues aux joueurs)."
        },
        "elements": {
          "type": "array",
          "items": { "$ref": "#/$defs/Element" },
          "description": "Elements contenus dans ce layer. Last-placed-wins en cas de chevauchement."
        }
      }
    },
    "Element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "positions", "appearances"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "description": "Identifiant stable de l'Element, unique au sein du menu."
        },
        "positions": {
          "type": "string",
          "pattern": "^\\d+(-\\d+)?$",
          "description": "Position(s) Minecraft occupée(s). \"15\" ou range \"10-43\"."
        },
        "appearances": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Appearance" },
          "description": "Apparences évaluées dans l'ordre. Première dont `if` matche gagne. Aucune match → fall-through au layer suivant."
        },
        "iterates": {
          "$ref": "#/$defs/Iterates",
          "description": "Si présent, l'Element devient itératif : pour chaque item du contextInput nommé `source` (de type \"list\"), le moteur évalue les appearances avec l'item courant exposé sous `alias`, accessible via {alias.field}. Mutuellement exclusif avec component_ref."
        },
        "template_ref": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/TemplateRef" }
          ]
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": {
          "type": "string",
          "maxLength": 1024,
          "description": "Notes internes de l'admin (jamais rendues aux joueurs)."
        }
      }
    },
    "ContextInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "description": "Slot nommée et typée exposée par le menu. Peuplée à l'ouverture par auto-binding par nom (depuis l'appelant : args de commande, contextInputs de l'appelant, alias d'iteration courant — cf. §15.4) ou via un ConnectorBinding attaché.",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "description": "Slug exposé comme {name} dans les champs du menu. Unique au sein du menu."
        },
        "type": {
          "type": "string",
          "enum": ["player", "string", "integer", "number", "boolean", "list", "object"]
        },
        "default": {
          "type": "string",
          "description": "Valeur fallback si l'appelant ne passe rien et qu'aucun connecteur n'est attaché. Supporte les placeholders."
        },
        "source": {
          "$ref": "#/$defs/ConnectorBinding",
          "description": "Si présent, la valeur de la slot est fetchée par un connecteur au lieu d'être passée par l'appelant. Valide uniquement sur type=\"list\" ou type=\"object\"."
        }
      }
    },
    "ConnectorBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "description": "Référence vers un connecteur (homemade Artisan ou registered par un plugin tiers en V2). Attaché à un ContextInput via `source`. Le plugin appelle le connecteur au render et obtient une liste/objet typé qui peuple la slot.",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$",
          "description": "Identifiant du connecteur sous forme \"namespace:source\". Ex: \"chestshop:items\", \"essentials:warps\", \"jobs:list\"."
        },
        "params": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Paramètres passés au connecteur (varient par connecteur). Supportent {name} pour interpoler les autres contextInputs du menu, ainsi que placeholders PAPI et {i18n:key}."
        },
        "filter": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Filtres appliqués sur les champs de la data. Supportent {name} pour interpoler les autres contextInputs. Ex: { \"category\": \"{category}\" } ne garde que les items dont category == valeur de l'input \"category\"."
        },
        "sort": {
          "type": "object",
          "additionalProperties": false,
          "required": ["by"],
          "properties": {
            "by": { "type": "string", "description": "Nom du champ de tri." },
            "direction": { "type": "string", "enum": ["asc", "desc"], "default": "asc" }
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Nombre max d'items retournés. Default = nombre de positions occupées par l'Element qui itère cette slot."
        }
      }
    },
    "Iterates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "alias"],
      "description": "Iteration : pour chaque item du contextInput `source` (type \"list\"), le moteur évalue les appearances de l'Element avec l'item courant exposé sous `alias`. Les champs accèdent aux propriétés de l'item via {alias.field}.",
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "description": "Nom d'un contextInput de type \"list\" déclaré sur le menu."
        },
        "alias": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "description": "Nom local de l'item courant dans la scope de l'Element. Exposé comme {alias} et {alias.field}."
        }
      }
    },
    "Appearance": {
      "type": "object",
      "additionalProperties": false,
      "description": "Une apparence complète et auto-suffisante. Le `if` détermine si cette apparence s'active. Si l'Element a `iterates`, les champs peuvent référencer {alias.field} pour accéder aux propriétés de l'item courant.",
      "properties": {
        "if": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Condition" },
          "description": "Conditions ANDées. Si absent, matche toujours (fallback)."
        },
        "asset": { "type": "string" },
        "material": { "type": "string", "description": "Material vanilla (DIAMOND), ou un placeholder : {input_name} pour un contextInput, {alias.field} dans un Element qui itère." },
        "count": { "type": "integer", "minimum": 1, "maximum": 64, "default": 1 },
        "title": { "type": "string" },
        "lore": { "type": "array", "items": { "type": "string" } },
        "enchanted": { "type": "boolean", "default": false },
        "custom_model_data": { "type": "string" },
        "component_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"
        },
        "click": {
          "oneOf": [
            { "$ref": "#/$defs/ClickMap" },
            { "type": "null" }
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 1024,
          "description": "Notes internes de l'admin (jamais rendues aux joueurs)."
        }
      }
    },
    "ClickMap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "left":        { "$ref": "#/$defs/ClickHandler" },
        "right":       { "$ref": "#/$defs/ClickHandler" },
        "shift_left":  { "$ref": "#/$defs/ClickHandler" },
        "shift_right": { "$ref": "#/$defs/ClickHandler" },
        "middle":      { "$ref": "#/$defs/ClickHandler" }
      }
    },
    "ClickHandler": {
      "oneOf": [
        { "$ref": "#/$defs/StandardClick" },
        { "$ref": "#/$defs/ComponentClick" }
      ]
    },
    "StandardClick": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions"],
      "properties": {
        "requirements": { "type": "array", "items": { "$ref": "#/$defs/Condition" } },
        "actions":      { "type": "array", "items": { "$ref": "#/$defs/Action" } },
        "fallback":     { "type": "array", "items": { "$ref": "#/$defs/Action" } },
        "cooldown":     { "$ref": "#/$defs/Cooldown" }
      }
    },
    "ComponentClick": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use_component_default"],
      "properties": {
        "use_component_default": { "const": true },
        "then_actions": { "type": "array", "items": { "$ref": "#/$defs/Action" } },
        "requirements": { "type": "array", "items": { "$ref": "#/$defs/Condition" } },
        "fallback":     { "type": "array", "items": { "$ref": "#/$defs/Action" } },
        "cooldown":     { "$ref": "#/$defs/Cooldown" }
      }
    },
    "Cooldown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "duration_seconds"],
      "properties": {
        "id": { "type": "string" },
        "duration_seconds": { "type": "integer", "minimum": 1 },
        "scope": { "type": "string", "enum": ["player", "server"], "default": "player" },
        "message": { "type": "string" }
      }
    },
    "TemplateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id":        { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "vars":      { "type": "object", "additionalProperties": true },
        "overrides": { "type": "object", "additionalProperties": true }
      }
    },
    "Action": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        { "additionalProperties": false, "required": ["type", "command"], "properties": { "type": { "const": "run_command" }, "command": { "type": "string" }, "as": { "type": "string", "enum": ["player", "console"], "default": "player" } } },
        { "additionalProperties": false, "required": ["type", "menu_id"], "properties": { "type": { "const": "open_menu" }, "menu_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }, "close_current": { "type": "boolean", "default": true }, "context": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Override explicite de l'auto-binding par nom (cf. §15.4). Chaque entrée peuple un contextInput du menu cible ; les valeurs supportent {name} pour interpoler la scope courante." }, "clear_context": { "type": "boolean", "default": false, "description": "Désactive l'auto-binding par nom (l'override `context` reste actif)." } } },
        { "additionalProperties": false, "required": ["type"],            "properties": { "type": { "const": "close_menu" } } },
        { "additionalProperties": false, "required": ["type", "material", "count"], "properties": { "type": { "const": "give_item" }, "material": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "count": { "type": "integer", "minimum": 1, "maximum": 64 }, "nbt": { "type": "string" }, "name": { "type": "string" }, "lore": { "type": "array", "items": { "type": "string" } } } },
        { "additionalProperties": false, "required": ["type", "material", "count"], "properties": { "type": { "const": "take_item" }, "material": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "count": { "type": "integer", "minimum": 1, "maximum": 64 }, "nbt": { "type": "string" } } },
        { "additionalProperties": false, "required": ["type", "amount"], "properties": { "type": { "const": "give_money" }, "amount": { "type": "number", "exclusiveMinimum": 0 }, "currency": { "type": "string" } } },
        { "additionalProperties": false, "required": ["type", "amount"], "properties": { "type": { "const": "take_money" }, "amount": { "type": "number", "exclusiveMinimum": 0 }, "currency": { "type": "string" } } },
        { "additionalProperties": false, "required": ["type", "amount"], "properties": { "type": { "const": "give_xp" }, "amount": { "type": "integer", "minimum": 1 } } },
        { "additionalProperties": false, "required": ["type", "amount"], "properties": { "type": { "const": "give_level" }, "amount": { "type": "integer", "minimum": 1 } } },
        { "additionalProperties": false, "required": ["type", "text"], "properties": { "type": { "const": "send_message" }, "text": { "type": "string" } } },
        { "additionalProperties": false, "required": ["type", "text"], "properties": { "type": { "const": "broadcast" }, "text": { "type": "string" } } },
        { "additionalProperties": false, "required": ["type", "sound"], "properties": { "type": { "const": "play_sound" }, "sound": { "type": "string" }, "volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 }, "pitch": { "type": "number", "minimum": 0, "maximum": 2, "default": 1 } } },
        { "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "teleport" }, "world": { "type": "string" }, "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" }, "yaw": { "type": "number" }, "pitch": { "type": "number" }, "warp_name": { "type": "string" } } },
        { "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "pagination_next" }, "element_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" } } },
        { "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "pagination_prev" }, "element_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" } } }
      ]
    },
    "Condition": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        { "additionalProperties": false, "required": ["type", "perm"], "properties": { "type": { "const": "has_permission" }, "perm": { "type": "string" } } },
        { "additionalProperties": false, "required": ["type", "amount"], "properties": { "type": { "const": "has_money" }, "amount": { "type": "number", "exclusiveMinimum": 0 }, "currency": { "type": "string" } } },
        { "additionalProperties": false, "required": ["type", "material", "count"], "properties": { "type": { "const": "has_item" }, "material": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "count": { "type": "integer", "minimum": 1 }, "nbt": { "type": "string" } } },
        { "additionalProperties": false, "required": ["type", "amount"], "properties": { "type": { "const": "has_xp" }, "amount": { "type": "integer", "minimum": 1 } } },
        { "additionalProperties": false, "required": ["type", "level"], "properties": { "type": { "const": "has_level" }, "level": { "type": "integer", "minimum": 1 } } },
        { "additionalProperties": false, "required": ["type", "placeholder", "value"], "properties": { "type": { "const": "placeholder_equals" }, "placeholder": { "type": "string", "description": "PAPI (%vault_eco_balance%), contextInput ({category}), ou champ d'iteration ({alias.field})." }, "value": { "type": "string" } } },
        { "additionalProperties": false, "required": ["type", "placeholder", "regex"], "properties": { "type": { "const": "placeholder_match" }, "placeholder": { "type": "string" }, "regex": { "type": "string" } } },
        { "additionalProperties": false, "required": ["type", "cooldown_id"], "properties": { "type": { "const": "cooldown_passed" }, "cooldown_id": { "type": "string" } } },
        { "additionalProperties": false, "required": ["type", "world"], "properties": { "type": { "const": "world_is" }, "world": { "type": "string" } } },
        { "additionalProperties": false, "required": ["type", "range"], "properties": { "type": { "const": "time_is" }, "range": { "oneOf": [ { "type": "string", "enum": ["day", "night"] }, { "type": "object", "additionalProperties": false, "required": ["from_ticks", "to_ticks"], "properties": { "from_ticks": { "type": "integer", "minimum": 0, "maximum": 24000 }, "to_ticks": { "type": "integer", "minimum": 0, "maximum": 24000 } } } ] } } },
        { "additionalProperties": false, "required": ["type", "probability"], "properties": { "type": { "const": "random_chance" }, "probability": { "type": "number", "minimum": 0, "maximum": 1 } } },
        { "additionalProperties": false, "required": ["type", "region"], "properties": { "type": { "const": "player_in_region" }, "region": { "type": "string" } } },
        { "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "pagination_at_first" }, "element_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" } } },
        { "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "pagination_at_last" }, "element_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" } } },
        { "additionalProperties": false, "required": ["type", "of"], "properties": { "type": { "const": "not" }, "of": { "$ref": "#/$defs/Condition" } } },
        { "additionalProperties": false, "required": ["type", "of"], "properties": { "type": { "const": "and" }, "of": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Condition" } } } },
        { "additionalProperties": false, "required": ["type", "of"], "properties": { "type": { "const": "or" }, "of": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Condition" } } } }
      ]
    }
  }
}
