# Copy this file to .env and fill in the values.

# Server key for the Minecraft server (generate one in the Artisan editor)
ARTISAN_SERVER_KEY=

# Public URL of the backend, as seen by the browser
API_BASE_URL=http://localhost:3001

# Internal URL of the backend, as seen by the Minecraft container (Docker service name)
# Change only if you rename the backend service in docker-compose.yml
BUNDLE_BASE_URL=http://backend:3001

# URL handed to player MC clients via setResourcePack. Must be reachable from
# the player's machine, NOT from inside the Docker network. Defaults to
# API_BASE_URL. For a remote production server set this to your public URL
# (e.g. https://artisan.example.com).
RESOURCE_PACK_BASE_URL=http://localhost:3001

# Override the WS URL used by the Minecraft plugin (defaults to internal Docker network)
# ARTISAN_WS_URL=ws://backend:3001/ws/plugin

# PostgreSQL connection string (dev local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/artisan

# Legacy assistant provider config — SEED ONLY since 2026-07: read once at boot
# to populate the ai_models catalog when it is empty. Runtime resolution goes
# through the DB catalog (admin > AI models). Safe to remove once seeded.
# ASSISTANT_PROVIDER=openai
# ASSISTANT_API_KEY=
# ASSISTANT_BASE_URL=https://api.openai.com/v1
# ASSISTANT_MODEL=gpt-4.1-mini

# --- Super-admin console ---
# Comma-separated list of emails promoted to platform super-admin on their next
# authenticated request (covers login / signup / Discord). The promotion is
# persisted once to users.is_admin; you can later revoke it from the DB.
# ADMIN_BOOTSTRAP_EMAILS=you@example.com,admin@example.com
#
# 32-byte hex key (64 chars) used by secretBox (AES-256-GCM) to encrypt secrets
# stored in the app_settings table (e.g. the admin-managed assistant API key).
# Leave empty to disable DB-backed secret storage (falls back to env vars).
# Generate with: openssl rand -hex 32
# CONFIG_ENC_KEY=

# Stripe billing (sub-project B). STRIPE_SECRET_KEY is read only by the real
# gateway; tests inject a fake. STRIPE_WEBHOOK_SECRET is used by B2's webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
#
# Return URLs for Stripe hosted checkout/portal (defaults to EDITOR_URL + /credits).
BILLING_SUCCESS_URL=
BILLING_CANCEL_URL=
BILLING_PORTAL_RETURN_URL=
#
# Grace period (days) after a failed subscription payment before suspension. Default 7.
BILLING_GRACE_DAYS=7

# --- Transactional email (SMTP, e.g. Scaleway TEM: smtp.tem.scw.cloud:587) ---
# Empty SMTP_HOST/USER/PASS/MAIL_FROM = mailer disabled (no-op, logs a WARN once).
# SMTP_HOST=smtp.tem.scw.cloud
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
