# Copy this file to .env and fill in the values.

# Server key for the Minecraft server (generate one in the Artisan editor)
ARTISAN_SERVER_KEY=

# Public URL of the backend, as seen by the browser
API_BASE_URL=http://localhost:3001

# Internal URL of the backend, as seen by the Minecraft container (Docker service name)
# Change only if you rename the backend service in docker-compose.yml
BUNDLE_BASE_URL=http://backend:3001

# URL handed to player MC clients via setResourcePack. Must be reachable from
# the player's machine, NOT from inside the Docker network. Defaults to
# API_BASE_URL. For a remote production server set this to your public URL
# (e.g. https://artisan.example.com).
RESOURCE_PACK_BASE_URL=http://localhost:3001

# Override the WS URL used by the Minecraft plugin (defaults to internal Docker network)
# ARTISAN_WS_URL=ws://backend:3001/ws/plugin

# PostgreSQL connection string (dev local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/artisan

# --- AI assistant (LLM provider) ---
# The assistant uses an OpenAI-compatible API, so you can point it at any
# provider that speaks that protocol. Leave ASSISTANT_API_KEY empty to disable
# the feature (unless ASSISTANT_PROVIDER=local, which needs no key).
#
# Pick a preset (sets base URL + default model) or override either explicitly.
# Known presets: openai (default), deepseek, mistral, openrouter, local.
# ASSISTANT_PROVIDER=openai
#
# API key for the chosen provider (not required for local servers).
# ASSISTANT_API_KEY=
#
# Optional overrides — only set these to deviate from the preset.
# ASSISTANT_BASE_URL=https://api.openai.com/v1
# ASSISTANT_MODEL=gpt-4.1-mini
#
# Examples:
#   OpenAI:    ASSISTANT_PROVIDER=openai   ASSISTANT_API_KEY=sk-...   (model gpt-4.1-mini)
#   DeepSeek:  ASSISTANT_PROVIDER=deepseek ASSISTANT_API_KEY=sk-...   (model deepseek-chat)
#   Mistral:   ASSISTANT_PROVIDER=mistral  ASSISTANT_API_KEY=...      (model mistral-large-latest)
#   Local:     ASSISTANT_PROVIDER=local                              (base http://localhost:11434/v1, model llama3.1, no key)
