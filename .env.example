# Copy this file to .env and fill in the values.
#
# This file is the reference for backend environment variables: every variable
# is documented here with its default and what it does. Keep it in sync when
# you add one (see the doc rule in CLAUDE.md).

# Server key for the Minecraft server (generate one in the Artisan editor)
ARTISAN_SERVER_KEY=

# --- URLs ---

# HTTP/WS port of the backend. Default: 3001
# PORT=3001

# Guest demos live in PostgreSQL (drafts only) and are disposable: export is the only way out.
# Effective writes renew inactivity; reads and operation retries do not.
# DEMO_TTL_HOURS=24
# DEMO_MINECRAFT_VERSION=1.21.4 # exact installed backend/data/items catalog
# DEMO_MAX_BYTES=20971520
# DEMO_MAX_FILES=1000
# DEMO_GLOBAL_MAX_BYTES=536870912
# DEMO_MAX_SESSIONS=1000
# DEMO_CREATIONS_PER_HOUR=5
# DEMO_MUTATIONS_PER_MINUTE=60
# Optional executable for scripts/backup-hosted.ts; alternatively pass --docker <postgres-container>.
# PG_DUMP_BIN=pg_dump

# Public URL of the backend, as seen by the browser.
# Sent to the plugin in hello_ack.api_url. Default: http://localhost:3001
API_BASE_URL=http://localhost:3001

# URL used in bundle_available.url — this is the PLUGIN downloading the menu
# bundle, so on the Docker network it must be the service name, not localhost.
# Defaults to API_BASE_URL (outside Docker they are identical).
# Change only if you rename the backend service in docker-compose.yml
BUNDLE_BASE_URL=http://backend:3001

# URL handed to player MC clients via setResourcePack. Must be reachable from
# the player's machine, NOT from inside the Docker network. Defaults to
# API_BASE_URL. For a remote production server set this to your public URL
# (e.g. https://artisan.example.com).
RESOURCE_PACK_BASE_URL=http://localhost:3001

# Browser-facing origin of the editor. Used for API CORS, OAuth redirects,
# invitations and hello_ack.server_url / editor_url.
# Default: http://localhost:5173
# EDITOR_URL=http://localhost:5173

# Optional second API CORS origin for the public marketing site. Empty by default.
# MARKETING_URL=https://artisanmc.net

# Override the WS URL used by the Minecraft plugin (defaults to internal Docker network)
# ARTISAN_WS_URL=ws://backend:3001/ws/plugin

# --- Database ---

# PostgreSQL connection string (dev local).
# Default: postgresql://postgres:postgres@localhost:5432/artisan
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/artisan

# --- Auth ---

# Google OAuth web client. All three values are required to show the button.
# Register the exact callback URI in Google Cloud Console (Web application).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback

# Discord OAuth. Leaving DISCORD_CLIENT_ID empty disables the
# "Continue with Discord" button.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Callback URI as configured in the Discord Developer Portal.
# DISCORD_REDIRECT_URI=http://localhost:3001/api/v1/auth/discord/callback

# Legacy assistant provider config — SEED ONLY since 2026-07: read once at boot
# to populate the ai_models catalog when it is empty. Runtime resolution goes
# through the DB catalog (admin > AI models). Safe to remove once seeded.
# ASSISTANT_PROVIDER=openai
# ASSISTANT_API_KEY=
# ASSISTANT_BASE_URL=https://api.openai.com/v1
# ASSISTANT_MODEL=gpt-4.1-mini

# --- Super-admin console ---
# Comma-separated list of emails promoted to platform super-admin on their next
# authenticated request (covers login / signup / Discord). The promotion is
# persisted once to users.is_admin (guarded by !isAdmin, so it is written a
# single time); you can later revoke it from the DB.
# ADMIN_BOOTSTRAP_EMAILS=you@example.com,admin@example.com
#
# 32-byte hex key (64 chars) used by secretBox (AES-256-GCM) to encrypt secrets
# stored in the app_settings table (e.g. the admin-managed assistant API key).
# Leave empty to disable DB-backed secret storage (falls back to env vars).
# Generate with: openssl rand -hex 32
# CONFIG_ENC_KEY=

# Stripe billing (sub-project B). STRIPE_SECRET_KEY is read only by the real
# gateway; tests inject a fake. STRIPE_WEBHOOK_SECRET is used by B2's webhook.
# Compose forwards both to the backend. Leave empty in dev/test until billing
# is configured; the admin plan form creates Stripe products/prices on save.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
#
# Return URLs for Stripe hosted checkout/portal (defaults to EDITOR_URL + /credits).
BILLING_SUCCESS_URL=
BILLING_CANCEL_URL=
BILLING_PORTAL_RETURN_URL=
#
# Grace period (days) after a failed subscription payment (invoice.payment_failed)
# before suspension (status=past_due + grace_until). Read at webhook time. Default 7.
BILLING_GRACE_DAYS=7

# --- Transactional email (SMTP, e.g. Scaleway TEM: smtp.tem.scw.cloud:587) ---
# Empty SMTP_HOST = getMailer() returns a no-op mailer (logs a WARN once).
# Account deletion requires SMTP: an unavailable/failed send returns an error.
# Docker Compose forwards these settings to the backend.
# MAIL_FROM is the From: address of transactional emails. SMTP_PORT default: 587.
# SMTP_HOST=smtp.tem.scw.cloud
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=

# Canal des releases du plugin : vide en prod, `staging` sur staging (n accepte alors que les versions 1.0.N-staging).
# PLUGIN_RELEASE_CHANNEL=
