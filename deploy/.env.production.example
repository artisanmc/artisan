# Artisan backend — production environment (paste into Coolify → app → Environment).
# These are SECRETS / per-deploy config: never commit a filled-in copy.

# Postgres — use the INTERNAL connection string Coolify gives the database
# resource (app and DB on the same Coolify network). Example shape:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/artisan

PORT=3001

# Public base URL of the backend. All three default to the same public origin
# in a single-domain deploy (the Docker-network split only mattered in dev).
API_BASE_URL=https://api.artisanmc.net
BUNDLE_BASE_URL=https://api.artisanmc.net
RESOURCE_PACK_BASE_URL=https://api.artisanmc.net
# ^ If you front the backend with Cloudflare (orange cloud), move the two
#   plugin-facing URLs below to a GREY-CLOUD subdomain to dodge CF's 100 MB
#   request cap on bundle uploads / resource-pack downloads, e.g.:
#   BUNDLE_BASE_URL=https://bundles.artisanmc.net
#   RESOURCE_PACK_BASE_URL=https://bundles.artisanmc.net

# Promote your account to super-admin on first authenticated request.
ADMIN_BOOTSTRAP_EMAILS=you@example.com

# 32-byte hex key for encrypting secrets stored in the DB (app_settings).
# Generate once and keep it stable:  openssl rand -hex 32
CONFIG_ENC_KEY=

# AI assistant (optional — leave empty to disable). OpenAI-compatible provider.
ASSISTANT_PROVIDER=
ASSISTANT_BASE_URL=
ASSISTANT_API_KEY=
ASSISTANT_MODEL=

# ── Editor build args (NOT backend env) — set on the EDITOR app in Coolify ──
# VITE_* are baked at build time into the static bundle, not read at runtime.
# VITE_API_URL=https://api.artisanmc.net
# VITE_PLUGIN_WS_URL=wss://api.artisanmc.net/ws/plugin
