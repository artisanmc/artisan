{
  "name": "artisan-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:site": "npm --prefix ../docs-site run build && vite --mode site",
    "generate-routes": "tsr generate",
    "build": "npm run generate-routes && tsc -p tsconfig.app.json && vite build",
    "build:self-hosted": "npm run build",
    "build:site": "npm --prefix ../docs-site run build && npm run generate-routes && vite build --mode site && node scripts/copy-wiki.mjs",
    "typecheck": "tsr generate && tsc -b",
    "preview": "vite preview",
    "preview:site": "vite preview --mode site",
    "pretest": "tsr generate",
    "test": "vitest",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "pack": "node scripts/pack.mjs"
  },
  "dependencies": {
    "@artisan/editor-sdk": "*",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dagrejs/dagre": "3.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-router": "^1.168.26",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/three": "^0.184.1",
    "@uiw/react-codemirror": "^4.25.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "es-module-lexer": "2.1.0",
    "fflate": "^0.8.2",
    "i18next": "^26.0.8",
    "immer": "^11.1.4",
    "jszip": "^3.10.1",
    "konva": "^10.2.5",
    "lucide-react": "^1.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.6",
    "react-konva": "^19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "use-image": "^1.1.4",
    "yaml": "^2.8.4",
    "zundo": "^2.3.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/router-cli": "^1.166.38",
    "@tanstack/router-plugin": "^1.167.29",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jiti": "^2.6.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.5"
  }
}
