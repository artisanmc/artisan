    "jose": "^6.2.12",
    "nodemailer": "^9.0.3",
    "openai": "^6.42.0",
    "pngjs": "^7.0.0",
    "postgres": "^3.4.4",
    "stripe": "^22.3.0",
    "yaml": "^2.8.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/nodemailer": "^8.0.1",
    "@types/pngjs": "^6.0.5",
