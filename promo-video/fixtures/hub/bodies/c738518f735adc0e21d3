tes: \"{n}m\"\n    seconds: \"{n}s\"\n"},{"path":"menus/hub.yml","content":"schema: menu/v1\n# The server's main menu: one entry per gameplay system, the modules included.\ntitle:\n  - kind: background\n    asset_id: hub_background\n  - kind: text\n    value: { en: \"Survival · Main menu\", fr: \"<#4a2f12>Survie · Menu principal\" }\n    x: 8\n    y: 6\n  - kind: glyph\n    asset_id: coin\n    x: 150\n    y: 2\nsize: 54\nelements:\n  - id: profile\n    positions: 4\n    material: PLAYER_HEAD\n    head: \"playerhead:{player.name}\"\n    title: \"<gold><bold>{player.name}\"\n    lore:\n      en:\n        - \"<gray>First visit: <white>{player.first_seen.ago()} ago\"\n        - \"<gray>Time played: <white>{player.playtime.duration()}\"\n        - \"\"\n        - \"{player.world == \\\"world\\\" ? \\\"<green>● In the overworld\\\" : \\\"<gray>● Exploring {player.world}\\\"}\"\n      fr:\n        - \"<gray>Première visite : <white>il y a {player.first_seen.ago()}\"\n        - \"<gray>Temps de jeu : <white>{player.playtime.duration()}\"\n        - \"\"\n        - \"{player.world == \\\"world\\\" ? \\\"<green>● Dans le monde principal\\\" : \\\"<gray>● En exploration : {player.world}\\\"}\"\n  - id: spawn\n    positions: 19\n    material: COMPASS\n    title: { en: \"<yellow>Spawn\", fr: \"<yellow>Spawn\" }\n    lore:\n      en: [ \"<gray>Back to the town square.\" ]\n      fr: [ \"<gray>Retour sur la place du village.\" ]\n    click:\n      left:\n        - close_menu\n        - teleport:\n            world: world\n            x: 0\n            y: 72\n            z: 0\n        - play_sound:\n            sound: ENTITY_ENDERMAN_TELEPORT\n            pitch: 1.2\n  - id: warps\n    positions: 20\n    material: ENDER_PEARL\n    title: { en: \"<yellow>Warps\", fr: \"<yellow>Téléportations\" }\n    lore:\n      en: [ \"<gray>Mines, arena, farms and more.\" ]\n      fr: [ \"<gray>Mines, arène, fermes et plus.\" ]\n    click:\n      left:\n        - open_menu: warps\n  - id: shop\n    positions: 21\n    material: EMERALD\n    title: { en: \"<yellow>Shop\", fr: \"<yellow>Boutique\" }\n    lore:\n      en: [ \"<gray>Spend the coins you earn.\" ]\n      fr: [ \"<gray>Dépense les pièces que tu gagnes.\" ]\n    click:\n      left:\n        - open_menu: shop\n  - id: daily\n    positions: 23\n    material: CLOCK\n    title: { en: \"<yellow>Daily rewards\", fr: \"<yellow>Récompenses quotidiennes\" }\n    lore:\n      en: [ \"<gray>Log in every day, keep your streak.\" ]\n      fr: [ \"<gray>Connecte-toi chaque jour, garde ton streak.\" ]\n    click:\n      left:\n        - run_command: daily\n  - id: quests\n    positions: 24\n    material: WRITABLE_BOOK\n    title: { en: \"<yellow>Quests\", fr: \"<yellow>Quêtes\" }\n    lore:\n      en: [ \"<gray>Daily and weekly objectives.\" ]\n      fr: [ \"<gray>Objectifs du jour et de la semaine.\" ]\n    click:\n      left:\n        - run_command: quests\n  - id: guild\n    positions: 25\n    material: WHITE_BANNER\n    title: { en: \"<yellow>Guild\", fr: \"<yellow>Guilde\" }\n    lore:\n      en: [ \"<gray>Your guild, its bank and its ranks.\" ]\n      fr: [ \"<gray>Ta guilde, sa banque et ses grades.\" ]\n    click:\n      left:\n        - run_command: guild\n  - id: auctions\n    positions: 38\n    material: GOLD_INGOT\n    title: { en: \"<yellow>Auction house\", fr: \"<yellow>Hôtel des ventes\" }\n    lore:\n      en: [ \"<gray>Buy and sell with other players.\" ]\n      fr: [ \"<gray>Achète et vends entre joueurs.\" ]\n    click:\n      left:\n        - run_command: ah\n  - id: vote\n    positions: 40\n    material: DIAMOND\n    title: { en: \"<aqua>Vote for the server\", fr: \"<aqua>Voter pour le serveur\" }\n    lore:\n      en: [ \"<gray>One vote = one key, every day.\" ]\n      fr: [ \"<gray>Un vote = une clé, chaque jour.\" ]\n    click:\n      left:\n        - close_menu\n        - send_message: <aqua><click:open_url:'https://example.com/vote'>Click here to vote</click>\n  - id: rules\n    positions: 42\n    material: BOOK\n    title: { en: \"<yellow>Rules\", fr: \"<yellow>Règlement\" }\n    click:\n      left:\n        - run_command: rules\n  - id: close\n    positions: 49\n    material: BARRIER\n    title: { en: \"<red>Close\", fr: \"<red>Fermer\" }\n    click:\n      left:\n        - close_menu\n"},{"path":"menus/shop.yml","content":"schema: menu/v1\ntitle:\n  - kind: background\n    asset_id: shop_background\n  - kind: text\n    value: { en: \"Shop\", fr: \"<#4a2f12>Boutique\" }\n    x: 8\n    y: 6\nsize: 27\nelements:\n  - id: balance\n    positions: 4\n    material: SUNFLOWER\n    title: { en: \"<gold>{player.balance} coins\", fr: \"<gold>{player.balance} pièces\" }\n  - id: kit_miner\n    positions: 10\n    material: DIAMOND_PICKAXE\n    title: { en: \"<aqua>Miner kit\", fr: \"<aqua>Kit mineur\" }\n    lore:\n      en: [ \"<gray>Pickaxe, torches and food.\", \"\", \"<gold>Price: 250 coins\", \"<yellow>Click to buy\" ]\n      fr: [ \"<gray>Pioche, torches et nourriture.\", \"\", \"<gold>Prix : 250 pièces\", \"<yellow>Clic pour acheter\" ]\n    click:\n      left:\n        - if:\n            - expression: balance >= 250\n          do:\n            - take_money: 250\n            - give_item:\n                material: DIAMOND_PICKAXE\n                count: 1\n            - give_item:\n                material: TORCH\n                count: 32\n            - play_sound:\n                sound: ENTITY_PLAYER_LEVELUP\n                pitch: 1.2\n            - send_message: <green>Miner kit bought.\n          else:\n            - send_message: <red>You need 250 coins.\n  - id: food\n    positions: 11\n    material: COOKED_BEEF\n    title: { en: \"<yellow>Steak ×16\", fr: \"<yellow>Steak ×16\" }\n    lore:\n      en: [ \"<gold>Price: 40 coins\" ]\n      fr: [ \"<gold>Prix : 40 pièces\" ]\n  - id: elytra\n    positions: 12\n    material: ELYTRA\n    title: { en: \"<light_purple>Elytra\", fr: \"<light_purple>Élytres\" }\n    lore:\n      en: [ \"<gold>Price: 5,000 coins\" ]\n      fr: [ \"<gold>Prix : 5 000 pièces\" ]\n    click:\n      left:\n        - open_dialog: confirm_purchase\n  - id: rank_vip\n    positions: 14\n    material: NAME_TAG\n    title: { en: \"<green>VIP rank\", fr: \"<green>Grade VIP\" }\n    lore:\n      en: [ \"<gray>/hat, /craft, 2 homes more.\", \"\", \"<gold>Price: 10,000 coins\" ]\n      fr: [ \"<gray>/hat, /craft, 2 homes en plus.\", \"\", \"<gold>Prix : 10 000 pièces\" ]\n    click:\n      left:\n        - open_dialog: confirm_purchase\n    states:\n      - if:\n          - has_permission: rank.vip\n        material: LIME_DYE\n        title: { en: \"<green>VIP · owned\", fr: \"<green>VIP · possédé\" }\n        enchanted: true\n  - id: spawners\n    positions: 15\n    material: SPAWNER\n    title: { en: \"<red>Spawners\", fr: \"<red>Spawners\" }\n    lore:\n      en: [ \"<gray>Pig, cow, zombie, skeleton.\" ]\n      fr: [ \"<gray>Cochon, vache, zombie, squelette.\" ]\n  - id: keys\n    positions: 16\n    material: TRIPWIRE_HOOK\n    title: { en: \"<gold>Crate keys\", fr: \"<gold>Clés de box\" }\n  - id: back\n    positions: 22\n    material: ARROW\n    title: { en: \"<gray>Back\", fr: \"<gray>Retour\" }\n    click:\n      left:\n        - open_previous_menu\n"},{"path":"menus/warps.yml","content":"schema: menu/v1\ntitle:\n  - kind: plain\n    value: { en: \"<dark_gray>Warps\", fr: \"<dark_gray>Téléportations\" }\nsize: 36\nelements:\n  - id: mine\n    positions: 10\n    material: IRON_PICKAXE\n    title: { en: \"<yellow>Resource world\", fr: \"<yellow>Monde ressources\" }\n    lore:\n      en: [ \"<gray>Reset every Monday.\" ]\n      fr: [ \"<gray>Réinitialisé chaque lundi.\" ]\n    click:\n      left:\n        - close_menu\n        - run_command: rtp resources\n  - id: nether\n    positions: 12\n    material: NETHERRACK\n    title: { en: \"<red>Nether\", fr: \"<red>Nether\" }\n    click:\n      left:\n        - close_menu\n        - teleport:\n            world: world_nether\n            x: 0\n  