        "menus/.draft.yaml",
        "menus/readme.txt",
        "boutique/notes.yaml",
        "boutique/shop.yaml"
      ],
      "documents": [],
      "errors": []
    },
    {
      "name": "the same id twice for one kind refuses both, other kinds keep it",
