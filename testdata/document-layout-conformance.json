        { "path": "menus/main.yml", "dir": "menus", "id": "main", "folder": "" },
        { "path": "menus/ranks.yml", "dir": "menus", "id": "ranks", "folder": "" }
      ],
      "errors": [],
      "variants": [
        { "path": "variants/bedrock/dialogs/rules.yml", "dir": "dialogs", "id": "rules", "folder": "", "variant": "bedrock" },
        { "path": "variants/bedrock/menus/ranks.yaml", "dir": "menus", "id": "ranks", "folder": "", "variant": "bedrock" },
        { "path": "variants/textured/menus/info.yml", "dir": "menus", "id": "info", "folder": "", "variant": "textured" },
