    "expr": "\"10\" < \"9\"",
    "scope": {},
    "expected": false
  },
  {
    "name": "null equals empty string is true",
    "expr": "missing == \"\"",
    "scope": {},
    "expected": true
  },
  {
    "name": "null equals empty via null literal",
    "expr": "missing == null",
    "scope": {},
    "expected": true
  },
  {
    "name": "null equals zero is false",
    "expr": "missing == 0",
    "scope": {},
    "expected": false
  },
  {
    "name": "arithmetic sum then compare true",
    "expr": "gold + silver > 500",
    "scope": { "gold": 300, "silver": 250 },
    "expected": true
  },
  {
    "name": "arithmetic sum then compare false",
    "expr": "gold + silver > 500",
    "scope": { "gold": 100, "silver": 100 },
    "expected": false
  },
  {
    "name": "arithmetic subtraction then compare",
    "expr": "gold - silver == 0",
    "scope": { "gold": 5, "silver": 5 },
    "expected": true
  },
  {
    "name": "left-to-right arithmetic",
    "expr": "a - b + c == 4",
    "scope": { "a": 10, "b": 8, "c": 2 },
    "expected": true
  },
  {
    "name": "missing path bare truthy is false",
    "expr": "is_vip",
    "scope": {},
    "expected": false
  },
  {
    "name": "bare truthy true",
    "expr": "is_vip",
    "scope": { "is_vip": true },
    "expected": true
  },
  {
    "name": "bare number truthy nonzero",
    "expr": "count",
    "scope": { "count": 5 },
    "expected": true
  },
  {
    "name": "bare number zero is falsy",
    "expr": "count",
    "scope": { "count": 0 },
    "expected": false
  },
  {
    "name": "bare empty string is falsy",
    "expr": "label",
    "scope": { "label": "" },
    "expected": false
  },
  {
    "name": "bare false-literal string is truthy",
    "expr": "flag",
