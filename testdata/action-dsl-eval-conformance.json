    "scope": { "level": 5 },
    "expected": true
  },
  {
    "name": "numeric != true",
    "expr": "level != 5",
    "scope": { "level": 3 },
    "expected": true
  },
  {
    "name": "string == true",
    "expr": "name == \"alice\"",
    "scope": { "name": "alice" },
    "expected": true
  },
  {
    "name": "string == false",
    "expr": "name == \"alice\"",
    "scope": { "name": "bob" },
    "expected": false
