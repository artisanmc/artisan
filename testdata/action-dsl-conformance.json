    "ast": [
      {
        "kind": "if",
        "cases": [
          {
            "conditions": [{ "type": "time_is", "range": { "from_ticks": 1000, "to_ticks": 5000 } }],
            "steps": [{ "kind": "action", "action": { "type": "broadcast", "text": { "lit": "daytime" } } }]
          }
        ]
      }
    ]
  },
  {
    "name": "if else",
    "dsl": "if has_permission(vip):\n  give_money 100\nelse:\n  send_message \"denied\"",
    "canonicalDsl": "if has_permission(vip):\n  give_money 100\nelse:\n  send_message \"denied\"",
    "ast": [
      {
        "kind": "if",
        "cases": [
          {
            "conditions": [{ "type": "has_permission", "perm": "vip" }],
            "steps": [{ "kind": "action", "action": { "type": "give_money", "amount": 100 } }]
          }
        ],
        "else": [
          { "kind": "action", "action": { "type": "send_message", "text": { "lit": "denied" } } }
        ]
      }
    ]
  },
  {
    "name": "else if chain with and",
    "dsl": "if has_permission(vip) and random_chance(0.5):\n  broadcast \"a\"\nelse if cooldown_passed(daily):\n  broadcast \"b\"",
    "canonicalDsl": "if has_permission(vip) and random_chance(0.5):\n  broadcast \"a\"\nelse if cooldown_passed(daily):\n  broadcast \"b\"",
    "ast": [
      {
        "kind": "if",
        "cases": [
          {
            "conditions": [
              { "type": "has_permission", "perm": "vip" },
              { "type": "random_chance", "probability": 0.5 }
            ],
            "joins": ["and"],
            "steps": [
              { "kind": "action", "action": { "type": "broadcast", "text": { "lit": "a" } } }
            ]
          },
          {
            "conditions": [{ "type": "cooldown_passed", "cooldown_id": "daily" }],
            "steps": [
              { "kind": "action", "action": { "type": "broadcast", "text": { "lit": "b" } } }
            ]
          }
        ]
      }
    ]
  },
  {
    "name": "grouped conditions",
    "dsl": "if has_permission(a) and (has_permission(b) or has_permission(c)):\n  broadcast \"x\"",
    "canonicalDsl": "if has_permission(a) and (has_permission(b) or has_permission(c)):\n  broadcast \"x\"",
    "ast": [
      {
        "kind": "if",
        "cases": [
          {
            "conditions": [
              { "type": "has_permission", "perm": "a" },
              {
                "type": "or",
                "of": [
                  { "type": "has_permission", "perm": "b" },
                  { "type": "has_permission", "perm": "c" }
                ]
              }
            ],
            "joins": ["and"],
            "steps": [
              { "kind": "action", "action": { "type": "broadcast", "text": { "lit": "x" } } }
            ]
          }
        ]
      }
    ]
  },
