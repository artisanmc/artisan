    "ast": [
      {
        "kind": "if",
        "cases": [
          {
            "conditions": [
              { "type": "placeholder_equals", "placeholder": "%vault_eco_balance%", "value": "0" }
            ],
            "steps": [
              { "kind": "action", "action": { "type": "send_message", "text": { "lit": "broke" } } }
            ]
          }
        ]
      }
    ]
  },
  {
    "name": "nested if with not",
    "dsl": "if has_permission(vip):\n  if not has_money(100):\n    send_message \"poor\"",
    "canonicalDsl": "if has_permission(vip):\n  if not has_money(100):\n    send_message \"poor\"",
    "ast": [
      {
        "kind": "if",
        "cases": [
          {
            "conditions": [{ "type": "has_permission", "perm": "vip" }],
            "steps": [
              {
                "kind": "if",
                "cases": [
                  {
                    "conditions": [{ "type": "not", "of": { "type": "has_money", "amount": 100 } }],
                    "steps": [
                      {
                        "kind": "action",
                        "action": { "type": "send_message", "text": { "lit": "poor" } }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
]
