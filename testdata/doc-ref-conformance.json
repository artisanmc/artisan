{
  "description": "Resolution of a Document reference (open_menu / open_dialog) on a server with several projects. Read by the editor (editor/src/domain/docRef.test.ts) and by the plugin (DocRefConformanceTest): a bare id resolves first in the referencing project (`from`), then on the server if it is defined only once there; `project:id` targets that project. `expect` = `<project>:<id>` of the Document reached, `missing` or `ambiguous`.",
  "documents": [
    { "project": "core", "id": "main" },
    { "project": "shop", "id": "main" },
    { "project": "shop", "id": "catalogue" },
    { "project": "a", "id": "dup" },
    { "project": "b", "id": "dup" }
  ],
  "cases": [
    { "ref": "main", "from": "core", "expect": "core:main" },
    { "ref": "main", "from": "shop", "expect": "shop:main" },
    { "ref": "catalogue", "from": "core", "expect": "shop:catalogue" },
    { "ref": "shop:main", "from": "core", "expect": "shop:main" },
    { "ref": "core:catalogue", "from": "core", "expect": "missing" },
    { "ref": "nope:main", "from": "core", "expect": "missing" },
    { "ref": "absent", "from": "core", "expect": "missing" },
    { "ref": "dup", "from": "core", "expect": "ambiguous" },
    { "ref": "dup", "from": "a", "expect": "a:dup" },
    { "ref": "main", "from": null, "expect": "ambiguous" },
    { "ref": "catalogue", "from": null, "expect": "shop:catalogue" },
    { "ref": ":main", "from": "core", "expect": "missing" },
    { "ref": "shop:", "from": "core", "expect": "missing" }
  ]
}
