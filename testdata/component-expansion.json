    {
      "name": "choice: a look picks one of a parameter's names, written as the value the component gives it; a name it does not list is the default; a default names another parameter; what a choice gives is the owner's image",
      "module": "shop",
      "components": {
        "": {
          "button": {
            "params": {
              "text": {
                "type": "text",
                "default": "OK"
              },
              "color": {
                "type": "choice",
                "default": "green",
                "values": {
                  "green": "button.3x1",
                  "primary": "button.primary.3x1",
                  "danger": "button.danger.3x1"
                }
              },
              "size": {
                "type": "choice",
                "values": [
                  "small",
                  "large"
                ]
              },
              "image": {
                "type": "image",
                "default": "{color}"
              }
            },
            "parts": [
              {
                "image": "{image}"
              },
              {
                "label": "{text} {size}"
              }
            ]
          }
        },
        "shop": {
          "tab": {
            "params": {
              "state": {
                "type": "choice",
                "default": "off",
                "values": [
                  "on",
                  "off"
                ]
              }
            },
            "parts": [
              {
                "image": "tab_{state}"
              },
              {
                "image": "{state}"
              }
            ]
          }
        }
      },
      "menu": {
        "id": "m",
        "size": 9,
        "elements": [
